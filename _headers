# Security baseline for every static response. Pages Functions set the same
# set in src/entity-seo.mjs SECURITY_HEADERS (they bypass this file).
# CSP: the enforced policy only blocks framing, <base> hijack and plugins (nothing the
# site uses). The Report-Only policy is the candidate full policy sized from the 2026-10-19
# security review (17 inline <script> blocks → script-src keeps 'unsafe-inline' until they
# are hashed or externalised), widened 2026-10-23 for what the web app loads or will load
# (consent.js from the apex on app., MapLibre/OpenFreeMap tiles + blob workers, Sentry
# ingest). Violations post to /csp-report (functions/csp-report.js); promote only after a
# clean week. HSTS lives here (the zone never sent it, audit 06 M1); no preload yet.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=(), geolocation=(self)
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://trydropapp.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; connect-src 'self' https://ebccwnkmsnhbljxxxdej.supabase.co wss://ebccwnkmsnhbljxxxdej.supabase.co https://app.trydropapp.com https://trydropapp.com https://tiles.openfreemap.org https://*.ingest.us.sentry.io; worker-src 'self' blob:; child-src blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; report-uri https://trydropapp.com/csp-report; report-to csp
  Reporting-Endpoints: csp="https://trydropapp.com/csp-report"

/.well-known/apple-app-site-association
  Content-Type: application/json

# Crew share fallback contains no board data; keep identifiers out of referrers.
/crew-picks/*
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow

# Open Knowledge Format bundle (agent-readable markdown).
/okf/*
  Content-Type: text/markdown; charset=utf-8

# Signed-in app shell (also served on app.trydropapp.com via the Worker).
/app/*
  X-Robots-Tag: noindex, nofollow

# Revalidate all static assets so a new deploy never serves stale CSS/JS
# against fresh HTML (the two-browser mismatch). no-cache = browser still
# caches but must revalidate via etag → cheap 304 when unchanged.
/*.css
  Cache-Control: no-cache

/*.js
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

# TikTok OAuth pages: the callback URL carries a one-time code; keep it out of referrers.
/tiktok/*
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
