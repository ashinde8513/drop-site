# Security baseline for every static response. Pages Functions set the same
# set in src/entity-seo.mjs SECURITY_HEADERS (they bypass this file).
# CSP: the enforced policy only blocks framing, <base> hijack and plugins (nothing the
# site uses). The Report-Only policy is the candidate full policy sized from the 2026-10-19
# security review (17 inline <script> blocks → script-src keeps 'unsafe-inline' until they
# are hashed or externalised); watch devtools/CSP reports before promoting it. HSTS is set
# at the Cloudflare zone, not here (APPROVALS S15).
/*
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=(), geolocation=(self)
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data:; connect-src 'self' https://ebccwnkmsnhbljxxxdej.supabase.co wss://ebccwnkmsnhbljxxxdej.supabase.co https://app.trydropapp.com https://trydropapp.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/.well-known/apple-app-site-association
  Content-Type: application/json

# Crew share fallback contains no board data; keep identifiers out of referrers.
/crew-picks/*
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow

# Open Knowledge Format bundle (agent-readable markdown).
/okf/*
  Content-Type: text/markdown; charset=utf-8

# Signed-in app shell (also served on app.trydropapp.com via the Worker).
/app/*
  X-Robots-Tag: noindex, nofollow

# Revalidate all static assets so a new deploy never serves stale CSS/JS
# against fresh HTML (the two-browser mismatch). no-cache = browser still
# caches but must revalidate via etag → cheap 304 when unchanged.
/*.css
  Cache-Control: no-cache

/*.js
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

# TikTok OAuth pages: the callback URL carries a one-time code; keep it out of referrers.
/tiktok/*
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
